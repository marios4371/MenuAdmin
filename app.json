{
  "expo": {
    "name": "MenuAdmin",
    "slug": "MenuAdmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shop-icon.png",
    "scheme": "menuadmin",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theristis.menuadmin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/shop-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.theristis.menuadmin",
      "softwareKeyboardLayoutMode": "pan",
      "backgroundColor": "#121212"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/shop-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/shop-icon.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}